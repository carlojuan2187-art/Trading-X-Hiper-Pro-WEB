# Obligatorios. No guardes secretos reales en Git.
TELEGRAM_BOT_TOKEN=replace-with-your-existing-token
ADMIN_TELEGRAM_ID=123456789
MONGO_URL=mongodb+srv://USER:PASSWORD@CLUSTER/DATABASE
MONGO_DB_NAME=TRADING_X_HIPER_PRO
MINIAPP_URL=https://your-existing-miniapp.example
# Nombre real del bot SIN @; se usa para el deep-link de verificación
BOT_USERNAME=TridiXbot
MINIAPP_ALLOWED_ORIGINS=https://your-existing-miniapp.example
# Mantén los valores actuales durante la actualización. Cambiar el secreto de
# cifrado requiere migración/PRIVATE_KEY_ENCRYPTION_SECRET_FALLBACKS.
WEBAPP_SESSION_SECRET=replace-with-existing-session-secret
PRIVATE_KEY_ENCRYPTION_SECRET=replace-with-existing-encryption-secret

# Tamaño: 100% del saldo elegible, limitado al capital configurado (ejemplo: 3 USDC).
MIN_CAPITAL_USDC=5
POSITION_PERCENT=1.0
MAX_TRADE_MARGIN_USDC=3
LEVERAGE=10
# MIN_CAPITAL_USDC exige saldo mínimo; no define el margen de cada operación.
# Conserva tus variables actuales: este archivo no se carga automáticamente.

# Cobertura: la rotación ya no depende de conseguir un fill.
SCAN_INTERVAL=15
SCANNER_DEPTH=80
SCANNER_SHORTLIST_DEPTH_FOR_L2=25
SCANNER_REFRESH_SECONDS=5
SCANNER_L2_BUDGET_SECONDS=12
SHORTLIST_HARD_CAP=8
SHORTLIST_EVAL_BUDGET_SECONDS=32
SHORTLIST_EVAL_MIN_CANDIDATES=4
SCANNER_MIN_24H_NOTIONAL=2000000
SCANNER_MIN_OPEN_INTEREST=250000
SCANNER_MAX_SPREAD_BPS=25
SCANNER_MIN_TOP_BOOK_NOTIONAL=2000
SIGNAL_CACHE_TTL_SECONDS=300
MARKET_CONTEXT_CACHE_TTL_SECONDS=300
STRATEGY_EVENT_RETENTION_DAYS=14
# Vacíos conservan defaults; lista única compartida por scanner/estrategias.
ALLOWED_TRADE_SYMBOLS=
BLOCKED_MEME_KEYWORDS=

# Entrada y ejecución: valores originales, con reserva adicional de RR.
MIN_ENTRY_RR=1.15
ENTRY_RR_RESERVE=0.05
ENTRY_MAX_DRIFT_PCT=0.0025
ENTRY_MAX_DRIFT_ATR_MULT=0.45
ENTRY_MAX_DRIFT_HARD_PCT=0.0065
EXECUTION_MAX_SPREAD_BPS=20
EXECUTION_IOC_MAX_SLIPPAGE_BPS=28

# Estrategia base: conserva filtros salvo correcciones de precisión/plan.
MTF_ATR_PCT_MIN=0.00075
MTF_ATR_PCT_MAX=0.018
MTF_H1_ADX_MIN=12
MTF_M15_ADX_MIN=11
MTF_M5_ADX_MIN=9.5
MTF_MIN_SCORE_TO_SIGNAL=69
MTF_TRIGGER_MAX_EMA20_EXTENSION_ATR=0.95
MTF_SL_MIN_PCT=0.0045
MTF_SL_HARD_MAX_PCT=0.014
MTF_RR_MIN=1.15
MTF_RESET_LOOKBACK_BARS=5
# Comparación histórica opcional: false solo retira EMA200 de la confirmación H1.
MTF_H1_REQUIRE_EMA200=true
MTF_H1_TRANSITION_ENABLED=true
MTF_H1_TRANSITION_ADX_MIN=16
MTF_M15_REQUIRE_EMA200=true
MTF_M15_PULLBACK_ENABLED=true
MTF_M15_PULLBACK_MAX_ATR=0.75
MTF_PENDING_SETUP_ENABLED=true
MTF_SETUP_MAX_AGE_BARS=8
STRATEGY_ROUTER_MODE=enforced
STRATEGY_ROUTER_RANGE_LIVE_ENABLED=false
STRATEGY_ROUTER_RANGE_SHADOW_ENABLED=true
LIQUIDITY_MIN_FINAL_RR=1.15
RANGE_MIN_RR=1.18
RANGE_TARGET_BUFFER=0.90

# No elimina frenos por pérdidas. 0 permite desactivar solamente cuota temporal.
MAX_TRADES_PER_HOUR=4
MAX_TRADES_PER_DAY=12
USER_RISK_PF_WINDOW=6
GLOBAL_RISK_PF_WINDOW=10

# Alternativa de Liquidity Sweep en tendencia; conserva sus filtros internos.
STRATEGY_ROUTER_LIQUIDITY_PROBE_ENABLED=true

# Evaluate full MTF strategy in RANGE; does not enable mean reversion.
STRATEGY_ROUTER_RANGE_CONTINUATION_ENABLED=true

# Revisión 2026-10-05: cambios de selección, reversibles por separado.
# Solo regímenes conocidos. Cada alternativa valida su estrategia completa.
STRATEGY_ROUTER_SETUP_FIRST_ENABLED=true
# Retroceso H1 acotado: mantiene estructura EMA50/EMA200 y pendiente EMA50.
MTF_H1_PULLBACK_ENABLED=true
MTF_H1_PULLBACK_MAX_ATR=0.50
# Respaldo local por bid/ask aunque el estado histórico diga TP/SL en exchange.
SOFTWARE_EXIT_GUARD_ENABLED=true

# FASE 6 — Acceso web con teléfono + contraseña y verificación de contacto Telegram
# WEB_BASE_URL debe coincidir exactamente con el dominio HTTPS de WEB/API.
# WEB/API y AUTH-BOT deben compartir MONGO_URL y MONGO_DB_NAME.
# Start AUTH-BOT: python -m app.auth.bot_runner
# No activar AUTH-BOT y BOT LIVE simultáneamente con el mismo token (polling).
# Las variables OIDC de abajo son LEGADO, NO NECESARIAS para el nuevo login.
# Mantener WEB_LOGIN_ENABLED=false para evitar ofrecer el login OIDC anterior.
WEB_LOGIN_ENABLED=false
WEB_BASE_URL=https://TU-DOMINIO.example
TELEGRAM_OIDC_CLIENT_ID=
TELEGRAM_OIDC_CLIENT_SECRET=
TELEGRAM_OIDC_REDIRECT_URI=https://TU-DOMINIO.example/api/v1/auth/telegram/oidc/callback

# FASE 2 — Cuenta DEMO separada (WEB/API y DEMO worker; misma DB)
# Comienza apagado. No agregar variables LIVE adicionales al worker DEMO.
# SOLO en el servicio DEMO worker, además de DEMO_ENABLED=true:
# DEMO_WORKER_MODE=true  (permite iniciar sin entregar token de Telegram al worker)
DEMO_ENABLED=false
DEMO_INITIAL_EQUITY_USDC=100
DEMO_TAKER_FEE_BPS=5
DEMO_SLIPPAGE_BPS=2
DEMO_SCAN_SECONDS=300

# FASE 4: SOLO WORKER DEMO, socket upstream Hyperliquid
HYPERLIQUID_WS_URL=wss://api.hyperliquid.xyz/ws
# MongoDB debe estar configurado como replica set para Change Streams
# Si hay varias réplicas API, cada una mantiene su propio watcher Mongo.
# Para alta escala se recomienda fanout Redis dedicado (no incluido).
